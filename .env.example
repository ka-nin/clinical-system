# Copy to .env for local work. In production these are set as secrets on the host.
DJANGO_SETTINGS_MODULE=config.settings.dev

# ---- required in production (the app refuses to start without them) ----
DJANGO_SECRET_KEY=          # long random string, 40+ characters
DJANGO_ALLOWED_HOSTS=       # e.g. clinic.example.com
DATABASE_URL=               # e.g. postgres://user:password@host:5432/dbname
DJANGO_CSRF_TRUSTED_ORIGINS=  # e.g. https://clinic.example.com

# ---- optional ----
DJANGO_TIME_ZONE=UTC        # e.g. Asia/Manila
REQUIRE_2FA=1               # authenticator-app step for staff (on by default in production)
EMAIL_HOST=                 # SMTP server for password resets and approval emails
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CareBoard <no-reply@your-clinic.example>
TRUST_PROXY_HEADERS=      # set to 1 ONLY if the app sits behind a proxy you control; the audit log then records the real visitor address (X-Forwarded-For)
